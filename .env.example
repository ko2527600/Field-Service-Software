DATABASE_URL="postgresql://firearmour:firearmour@localhost:5432/firearmour?schema=public"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Optional: the API's own publicly reachable base URL, used as the Hubtel webhook
# callback target below. Not needed for local dev (Hubtel just can't reach localhost).
# API_PUBLIC_URL="https://api.example.com"

# Optional: Hubtel MoMo/card invoice payment links (Online Checkout API,
# https://developers.hubtel.com/). Leave unset to disable -- "Get MoMo Payment
# Link" on an invoice just fails with a clear error instead of calling Hubtel.
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# HUBTEL_MERCHANT_ACCOUNT_NUMBER=

# Optional: Hubtel SMS ("Quick Send") as an alternative renewal-reminder gateway
# to the default SMS_GATEWAY_LOGIN/PASSWORD above -- pick per-business in Settings.
# HUBTEL_SMS_CLIENT_ID=
# HUBTEL_SMS_CLIENT_SECRET=
# HUBTEL_SMS_SENDER_ID=

# Optional: SMS renewal reminders (cloud-relay mode of "SMS Gateway for Android" by capcom6,
# https://docs.sms-gate.app/). Leave unset locally -- reminders just fail with a clear per-unit
# error instead of actually sending, unless a business also has smsRemindersEnabled turned on.
# SMS_GATEWAY_LOGIN=
# SMS_GATEWAY_PASSWORD=
# SMS_DEFAULT_COUNTRY_CODE="+233"
