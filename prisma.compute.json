{
  "region": "eu-central-1",
  "app": {
    "name": "api",
    "root": "apps/api",
    "framework": "custom",
    "httpPort": 4000,
    "env": {
      "vars": {
        "PORT": "4000"
      }
    },
    "build": {
      "command": "npm run build",
      "outputDirectory": "dist",
      "entrypoint": "index.js"
    }
  }
}
