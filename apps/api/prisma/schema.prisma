generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id           String   @id @default(uuid())
  name         String
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  phone        String?
  email        String?
  nextInvoiceSeq Int    @default(1)
  smsRemindersEnabled   Boolean @default(false)
  smsReminderDaysBefore Int     @default(7)
  createdAt    DateTime @default(now())

  customers Customer[]
  users     User[]
  invoices  Invoice[]

  @@map("businesses")
}

model User {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([businessId])
  @@map("users")
}

model Customer {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id])

  name         String
  contactPhone String?
  contactEmail String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  businessType String?
  notes        String?
  archivedAt   DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  units        Unit[]
  invoices     Invoice[]

  @@index([businessId])
  @@map("customers")
}

enum RenewalPeriod {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  CUSTOM
}

enum ExtinguisherType {
  ABC_DRY_CHEMICAL
  CO2
  WATER
  FOAM
  WET_CHEMICAL
  CLASS_D
  OTHER
}

model Unit {
  id                 String           @id @default(uuid())
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type               ExtinguisherType
  size               String
  serialNumber       String
  installDate        DateTime
  renewalPeriod      RenewalPeriod
  customIntervalDays Int?

  renewalDate        DateTime
  location           String?
  archivedAt         DateTime?

  reminderSentForRenewalDate DateTime?

  createdAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt

  serviceLogs        ServiceLog[]
  invoiceLineItems   InvoiceLineItem[]

  @@index([customerId])
  @@index([renewalDate])
  @@map("units")
}

model ServiceLog {
  id            String   @id @default(uuid())
  unitId        String
  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  serviceDate   DateTime
  technician    String?
  amountCharged Decimal? @db.Decimal(10, 2)
  notes         String?
  nextDueDate   DateTime

  createdAt     DateTime @default(now())

  @@index([unitId])
  @@map("service_logs")
}

model Invoice {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])

  invoiceNumber String   @unique
  issueDate     DateTime @default(now())
  dueDate       DateTime?
  notes         String?
  subtotal      Decimal  @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)

  createdAt     DateTime @default(now())

  lineItems     InvoiceLineItem[]

  @@index([businessId])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id])

  description String
  serviceType String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  lineTotal   Decimal  @db.Decimal(10, 2)

  @@index([invoiceId])
  @@map("invoice_line_items")
}
