# Used only for the native Android build (vite --mode capacitor). The app
# ships as a bundled WebView with no same-origin server to proxy through
# (unlike the Vercel-hosted PWA), so it needs the API's real absolute URL.
# Update this once your Render API is live at its real URL.
VITE_API_BASE_URL=https://fire-armour-api.onrender.com/api/v1
